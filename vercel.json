{
  "version": 2,
  "builds": [
    {
      "src": "app.js",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "Admin/**", "Customer/**", "Employee/**", "LogInRegister/**",
          "WelcomePage/**", "Taskbar/**", "assets/**", "images/**",
          "output.css", "pageProtection.js", "denied.html", "missingPageError.html"
        ]
      }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "/app.js" }
  ]
}